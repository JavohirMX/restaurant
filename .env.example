# Environment Configuration
# Copy this file to .env and fill in your actual values

# Django Settings
DEBUG=True
SECRET_KEY=change-me-in-production-use-a-random-string-at-least-50-chars
JWT_SECRET=change-me-too-different-from-secret-key-for-defense-in-depth

# Database (for docker-compose and Django)
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# For Django DATABASE_URL format (alternative to individual vars)
# DATABASE_URL=postgres://restaurant:your-secure-password-here@localhost:5432/restaurant

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Origins (comma-separated, for frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (SMTP) - Optional for development (uses console backend by default)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-api-key-here
# DEFAULT_FROM_EMAIL=noreply@yourrestaurant.com

# Security (production only)
SECURE_SSL_REDIRECT=False

# Google Analytics (optional)
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
