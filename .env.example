# =============================================================================
# Restaurant Management Platform - Environment Configuration
# =============================================================================
# Copy this file to .env (local), .env.staging, or .env.production and fill in
# the values. NEVER commit the actual .env files to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=change_me_in_production_use_strong_password

# -----------------------------------------------------------------------------
# Django Configuration
# -----------------------------------------------------------------------------
# Debug mode (true for development, false for production)
DEBUG=true

# Secret key (generate with: openssl rand -base64 48)
# Minimum 50 characters recommended
SECRET_KEY=your-secret-key-here-min-50-chars-long-for-security

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CSRF trusted origins (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Secret (different from SECRET_KEY, generate with: openssl rand -base64 48)
JWT_SECRET=your-jwt-secret-different-from-django-secret-key

# SSL redirect (true for production with HTTPS)
SECURE_SSL_REDIRECT=false

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
# Email backend type: "console" for development, "smtp" for production
EMAIL_BACKEND_TYPE=console

# SMTP settings (only used when EMAIL_BACKEND_TYPE=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password-or-smtp-password
DEFAULT_FROM_EMAIL=noreply@your-domain.com
STAFF_EMAIL=admin@your-domain.com

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Deployment Configuration (for staging/production)
# -----------------------------------------------------------------------------
# GitHub repository (format: owner/repo)
GITHUB_REPOSITORY=yourusername/restaurant

# Docker image tag
IMAGE_TAG=latest

# Domain name
DOMAIN=your-domain.com

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_DIR=./backups
RETENTION_DAYS=30
